<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Android 12+ masks the splash icon to a circle. The simplified tree-and-
        lotus mark stays legible after Android scales the splash on large
        screens, while the 288dp canvas keeps all visible artwork in the safe
        area.
    -->
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="288dp"
                android:height="288dp" />
        </shape>
    </item>
    <item
        android:width="176dp"
        android:height="176dp"
        android:drawable="@drawable/tredhah_launcher_mark_hd"
        android:gravity="center" />
</layer-list>
