NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
DB_DATABASE=dev.sqlite
# Production (Supabase Session Pooler, port 5432). Never commit the real value.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Keep the initial free-tier connection pool deliberately small.
DB_POOL_MAX=5
# Private object storage. Keep the service-role key on the server only.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=replace-with-server-secret-key
SUPABASE_STORAGE_BUCKET=family-media
HOST=0.0.0.0
PORT=3001
# Comma-separated browser origins. Native Android clients do not require CORS.
CORS_ORIGINS=
# Google Auth Platform Web application client ID. This is an identifier, not a secret.
# GOOGLE_OAUTH_CLIENT_ID=123456789-example.apps.googleusercontent.com
# Global operator user IDs allowed to update app release policy. Family-space roles do not apply.
# SYSTEM_ADMIN_USER_IDS=00000000-0000-4000-8000-000000000000
ANDROID_API_CONTRACT_VERSION=1
# Restrict each deployed backend to the client channel it is meant to serve.
ANDROID_ACCEPTED_RELEASE_CHANNELS=DEBUG,PILOT,PRODUCTION
ANDROID_DEBUG_MIN_SUPPORTED_VERSION_CODE=1
ANDROID_DEBUG_LATEST_VERSION_CODE=1
ANDROID_DEBUG_ENFORCEMENT_ENABLED=false
ANDROID_PILOT_MIN_SUPPORTED_VERSION_CODE=1
ANDROID_PILOT_LATEST_VERSION_CODE=1
ANDROID_PILOT_ENFORCEMENT_ENABLED=false
# ANDROID_PILOT_UPDATE_URL=https://example.com/familyroot/pilot
ANDROID_PRODUCTION_MIN_SUPPORTED_VERSION_CODE=1
ANDROID_PRODUCTION_LATEST_VERSION_CODE=1
ANDROID_PRODUCTION_ENFORCEMENT_ENABLED=false
# ANDROID_PRODUCTION_UPDATE_URL=https://play.google.com/store/apps/details?id=com.example.familytreeplatform
